{
  "name": "ai-coding-managers-lab",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },

  "portsAttributes": {
    "1433": { "onAutoForward": "silent" }
  },

  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Klucz API Anthropic od trenera (Dane dostepowe na platformie). Wymagany dla Claude Code."
    },
    "OPENAI_API_KEY": {
      "description": "Klucz API OpenAI dla Codex. Opcjonalny, zostaw puste."
    },
    "OPENROUTER_API_KEY": {
      "description": "Klucz OpenRouter od trenera (Dane dostepowe na platformie), limit 1 USD. Potrzebny dopiero w pracy domowej, lekcja 14. Opcjonalny."
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}
